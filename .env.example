# ==========================================
# FORENSIC-X Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ==========================================

# Application
FORENSICX_APP_NAME=FORENSIC-X
FORENSICX_VERSION=0.1.0
FORENSICX_ENV=development
FORENSICX_DEBUG=true
FORENSICX_LOG_LEVEL=INFO

# Database (SQLite for MVP; change to postgresql:// later)
FORENSICX_DATABASE_URL=sqlite:///./forensicx.db

# Server
FORENSICX_HOST=127.0.0.1
FORENSICX_PORT=8000

# CORS (frontend origin)
FORENSICX_CORS_ORIGINS=["http://localhost:5173"]

# Evidence storage paths
FORENSICX_EVIDENCE_STORE_PATH=./data/evidence_store
FORENSICX_WORKING_PATH=./data/working

# Placeholder for future AI integration
# FORENSICX_AI_API_KEY=your-api-key-here
# FORENSICX_AI_MODEL=your-model-name
